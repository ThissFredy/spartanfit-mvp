generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model KnowledgeChunk {
  id        String                     @id @default(uuid())
  content   String                     @db.Text
  metadata  Json?
  embedding Unsupported("vector(768)")
}

model UserStats {
  id                 String   @id @default(uuid())
  userId             String   @unique
  avgDaysPerWeek     Float    @default(0)
  weeklyVolumeLoad   Float    @default(0)
  favoriteExerciseId String?
  lastCalculatedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model City {
  id        String        @id @default(uuid())
  name      String        @unique
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  gyms      GymLocation[]
}

model GymLocation {
  id        String   @id @default(uuid())
  name      String
  address   String?
  isActive  Boolean  @default(true)
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userGyms UserGym[]
}

model UserGym {
  id            String   @id @default(uuid())
  userId        String
  gymLocationId String
  assignedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymLocation GymLocation @relation(fields: [gymLocationId], references: [id], onDelete: Cascade)

  @@unique([userId, gymLocationId])
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  age           Int?
  weight        Float?
  height        Float?
  activityIndex Int?
  goal          String @default("pending") // hipertrofia, fuerza, perdida de peso, mantención, salud general

  status UserStatus @default(ACTIVE)
  roleId String?
  role   Role?      @relation(fields: [roleId], references: [id])

  userGyms  UserGym[]
  createdAt DateTime  @default(now())

  metrics   Metric[]
  workouts  WorkoutLog[]
  messages  ChatMessage[]
  userStats UserStats?
}

model Metric {
  id         String   @id @default(uuid())
  userId     String
  weight     Float // Peso corporal en kg
  height     Float // Estatura en cm
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Exercise {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutLogs WorkoutLog[]
}

model WorkoutLog {
  id         String   @id @default(uuid())
  userId     String
  exerciseId String
  sets       Int
  weightLoad Float // Carga levantada
  reps       Int
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
}

model Content {
  id              String  @id @default(uuid())
  title           String
  contentUrl      String // Link al video o artículo
  isScienceBacked Boolean @default(true) // Diferencia Evidencia Científica de Comunidad
  difficultyLevel String // "Principiante", "Intermedio"
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String // "user" o "coach"
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
